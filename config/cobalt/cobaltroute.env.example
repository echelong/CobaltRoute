# CobaltRoute recommended production policy preset
# Built by Cobalt.
#
# This file contains policy only. Do not place provider credentials here in git.

# Prefer explicitly free capacity whenever it exists.
COBALTROUTE_FREE_ONLY=1

# V1/V2 — persistent task-aware adaptive learning + automatic outcomes.
COBALTROUTE_ADAPTIVE_PERSIST=1
COBALTROUTE_AUTOMATIC_FEEDBACK=1

# V4 — reset-aware free quota inventory.
COBALTROUTE_FREE_QUOTA_INTELLIGENCE=1

# V5 — verified bounded free-model racing.
COBALTROUTE_MULTI_MODEL_RACE=1
COBALTROUTE_RACE_WIDTH=3

# V6 — synced free-model discovery, probation, qualification, quarantine.
COBALTROUTE_FREE_MODEL_DISCOVERY=1
COBALTROUTE_DISCOVERY_PERSIST=1

# V7 — deterministic request/response/tool compatibility repair + learning.
COBALTROUTE_PROTOCOL_COMPATIBILITY=1

# V8 — local/self-hosted plus cloud routing.
COBALTROUTE_HYBRID_LOCAL_CLOUD=1
COBALTROUTE_HYBRID_POLICY=balanced

# Optional: comma-separated custom provider IDs that are truly local/self-hosted.
# COBALTROUTE_LOCAL_PROVIDER_IDS=openai-compatible-home,my-lan-model

# Optional persistence locations. Defaults already live under .data/cobaltroute/.
# COBALTROUTE_ADAPTIVE_STORE_PATH=.data/cobaltroute/adaptive-learning.json
# COBALTROUTE_CODING_FEEDBACK_STORE_PATH=.data/cobaltroute/coding-feedback.json

# Never commit API keys, refresh tokens, cookies, authorization headers, or passwords.
